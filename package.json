{
  "name": "eventhub-automation-testing",
  "version": "1.0.0",
  "description": "Playwright UI and API test automation for EventHub",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "report": "playwright show-report reports/html",
    "lint": "eslint -c quality-gate/eslint.config.mjs tests src --no-error-on-unmatched-pattern",
    "lint:fix": "eslint -c quality-gate/eslint.config.mjs tests src --no-error-on-unmatched-pattern --fix",
    "check:artifacts": "node quality-gate/scripts/CheckArtifacts.js",
    "prepare": "husky quality-gate/husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmoudTarek3009/EventHub-Automation-Testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MahmoudTarek3009/EventHub-Automation-Testing/issues"
  },
  "homepage": "https://github.com/MahmoudTarek3009/EventHub-Automation-Testing#readme",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7"
  }
}
