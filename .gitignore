# Dependencies
node_modules/

# Environment
.env

# Playwright output (reports/ is tracked via .gitkeep, contents are not)
/reports/*
!/reports/.gitkeep
/blob-report/

# Per-test run output (only .gitkeep may be tracked)
tests/**/output/*
!tests/**/output/.gitkeep
/playwright/.cache/
/playwright/.auth/

# Logs
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
